# Credenciales LOCALES de ejemplo. Solo para desarrollo — nunca usar en producción.
# Copiar a .env: cp .env.example .env

# Nombre de la base de datos PostgreSQL
POSTGRES_DB=minijira
# Usuario de PostgreSQL
POSTGRES_USER=minijira
# Contraseña de PostgreSQL (local, ficticia)
POSTGRES_PASSWORD=minijira

# Host de la BD visto desde el backend (dentro de compose es el nombre del servicio)
DB_HOST=postgres
# Puerto de PostgreSQL
DB_PORT=5432
# Nombre de la BD que usa el backend
DB_NAME=minijira
# Usuario que usa el backend
DB_USER=minijira
# Contraseña que usa el backend
DB_PASSWORD=minijira

# Firma de JWT (Base64, mínimo 32 bytes; solo valor local de ejemplo)
JWT_SECRET=bWluaS1qaXJhLWRldi1qd3Qtc2VjcmV0LWtleS0zMi1ieXRlcyEhIQ==
JWT_ISSUER=mini-jira
JWT_EXPIRATION_SECONDS=3600
